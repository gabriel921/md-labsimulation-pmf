;define = -DUSE_MODIFIED_TIP3P_EPS
integrator               = md        
dt                       = 0.002     ; 2 fs
nsteps                   = 5000000    ; 1.0 ns

nstenergy                = 200
nstlog                   = 2000
nstxout-compressed       = 10000

continuation             = yes
constraint-algorithm     = lincs
constraints              = h-bonds

cutoff-scheme            = Verlet
rlist                    = 1.0

coulombtype              = PME
rcoulomb                 = 1.0

vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres

tcoupl                   = Nose-Hoover
tc-grps                  = System
tau-t                    = 2.0
ref-t                    = 310.15
nhchainlength            = 1

pcoupl                   = Parrinello-Rahman 
tau_p                    = 4.0
compressibility          = 4.46e-5
ref_p                    = 1.0 

pull                     = yes
pull-ngroups             = 2
pull-group1-name         = PEP1_central
pull-group2-name         = PEP2_central
pull-ncoords             = 1
pull-coord1-type         = umbrella
pull-coord1-geometry     = distance
pull-coord1-groups       = 1 2
pull-coord1-k            = 2000.0
pull-coord1-rate         = 0.0
pull-coord1-init         = WINDOW
pull-coord1-start        = no
